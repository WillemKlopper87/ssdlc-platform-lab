POSTGRES_PASSWORD=change-me
WOODPECKER_AGENT_SECRET=generate-with-openssl-rand-hex-32
# SADR-0004: set and persist this explicitly. Left to auto-generate, Woodpecker
# creates a new one on every restart and silently invalidates every session.
WOODPECKER_GRPC_SECRET=generate-with-openssl-rand-hex-32
GITEA_OAUTH_CLIENT_ID=from-gitea-oauth2-application-registration
GITEA_OAUTH_CLIENT_SECRET=from-gitea-oauth2-application-registration
# Optional. Change this when port 8000 is already in use.  It changes both
# Woodpecker's published and internal HTTP port; see SADR-0016.
WOODPECKER_PORT=8000
